<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SplashTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#09090E</item>

        <item name="android:navigationBarColor">#09090E</item>

        <item name="android:windowBackground">#09090E</item>

        <!-- Android 12+ system splash -->
        <item name="android:windowSplashScreenBackground">#09090E</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent_icon</item>
    </style>

</resources>